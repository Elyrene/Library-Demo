{
  "openapi": "3.0.3",
  "info": {
    "title": "图书馆管理系统 — 后端 API",
    "description": "基于 Spring Boot 3 + MyBatis + MySQL 的图书馆管理系统后端接口文档。\n\n**认证方式**：Session（Cookie）。登录后服务端将用户对象与角色写入 `HttpSession`，后续请求需携带 Cookie（前端 `withCredentials: true`）。\n\n**登录拦截器**：`/api/admins/**`、`/api/readers/**`、`/api/lends/**` 与 `/api/books/**` 需登录，未登录时直接返回 HTTP 401 + `{\"code\":401,\"mes\":\"未登录或登录已过期\"}`。`/api/auth/**` 不受拦截。\n\n**统一响应格式**：所有接口返回 `DataInfo<T>` 结构：\n\n| 字段 | 类型 | 说明 |\n|------|------|------|\n| code | int | `0` = 成功，`-1` = 业务失败，`401` = 未登录 |\n| mes | string | 消息 |\n| count | long | 分页总数（仅分页接口返回） |\n| data | any | 数据体 |\n\n> `@JsonInclude(NON_NULL)`：值为 `null` 的字段不会出现在 JSON 中。",
    "version": "1.0.0",
    "contact": { "name": "Library Service" }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "本地开发"
    }
  ],
  "tags": [
    { "name": "认证", "description": "登录 / 登出 / 当前用户" },
    { "name": "管理员", "description": "管理员 CRUD" },
    { "name": "读者", "description": "读者注册 / 查询" },
    { "name": "借阅", "description": "图书借阅、归还、查询、批量删除（需登录）" },
    { "name": "图书", "description": "图书管理（增删改查，需登录）" }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": ["认证"],
        "summary": "用户登录",
        "description": "根据 `role` 字段区分管理员 / 读者登录。成功后将用户对象和角色写入 Session。",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "examples": {
                  "success": {
                    "summary": "登录成功",
                    "value": { "code": 0, "mes": "ok" }
                  },
                  "fail": {
                    "summary": "账户或密码错误",
                    "value": { "code": -1, "mes": "账户或者密码错误" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["认证"],
        "summary": "登出",
        "description": "清除 Session 中的用户信息并使 Session 失效。",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "登出成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "example": { "code": 0, "mes": "ok" }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["认证"],
        "summary": "获取当前登录用户",
        "description": "返回 Session 中存储的当前用户信息（不含密码）。未登录时返回失败。",
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "当前用户信息",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoMe" },
                "examples": {
                  "admin": {
                    "summary": "管理员",
                    "value": {
                      "code": 0,
                      "mes": "ok",
                      "data": {
                        "role": "admin",
                        "user": { "id": 1, "username": "admin", "adminType": 1 }
                      }
                    }
                  },
                  "reader": {
                    "summary": "读者",
                    "value": {
                      "code": 0,
                      "mes": "ok",
                      "data": {
                        "role": "reader",
                        "user": {
                          "id": 1,
                          "username": "zhangsan",
                          "realName": "张三",
                          "sex": "男",
                          "birthday": "2001-04-01",
                          "address": "江西南昌",
                          "tel": "13767134834",
                          "email": "zhangsan@163.com",
                          "registerDate": "2025-01-15T10:30:00.000+08:00",
                          "readerNumber": "8120116001"
                        }
                      }
                    }
                  },
                  "not-logged-in": {
                    "summary": "未登录",
                    "value": { "code": -1, "mes": "未登录" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admins": {
      "get": {
        "tags": ["管理员"],
        "summary": "分页查询管理员列表",
        "description": "支持按用户名模糊搜索和管理员类型筛选。返回结果中 `password` 字段始终为 `null`（不序列化）。",
        "operationId": "listAdmins",
        "parameters": [
          {
            "name": "pageNum",
            "in": "query",
            "description": "页码（从 1 开始）",
            "required": false,
            "schema": { "type": "integer", "default": 1, "minimum": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "每页条数",
            "required": false,
            "schema": { "type": "integer", "default": 10, "minimum": 1 }
          },
          {
            "name": "username",
            "in": "query",
            "description": "用户名（模糊匹配）",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "adminType",
            "in": "query",
            "description": "管理员类型（0=普通, 1=超级管理员）",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "管理员分页列表",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoAdminList" },
                "example": {
                  "code": 0,
                  "mes": "ok",
                  "count": 3,
                  "data": [
                    { "id": 1, "username": "admin", "adminType": 1 },
                    { "id": 2, "username": "qqwer", "adminType": 0 },
                    { "id": 3, "username": "xy1222", "adminType": 0 }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["管理员"],
        "summary": "新增管理员",
        "description": "若 `adminType` 未传则默认为 `1`（超级管理员）。用户名重复时返回失败（code -1，mes \"用户名已存在\"）。",
        "operationId": "addAdmin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminCreate" },
              "example": {
                "username": "newadmin",
                "password": "123456",
                "adminType": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "新增结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "examples": {
                  "success": {
                    "value": { "code": 0, "mes": "ok" }
                  },
                  "duplicate": {
                    "summary": "用户名已存在",
                    "value": { "code": -1, "mes": "用户名已存在" }
                  },
                  "fail": {
                    "value": { "code": -1, "mes": "新增失败" }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["管理员"],
        "summary": "批量删除管理员",
        "description": "请求体为管理员 ID 数组。",
        "operationId": "deleteAdmins",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": { "type": "integer" },
                "minItems": 1
              },
              "example": [1, 2]
            }
          }
        },
        "responses": {
          "200": {
            "description": "删除结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "examples": {
                  "success": { "value": { "code": 0, "mes": "ok" } },
                  "empty": {
                    "value": { "code": -1, "mes": "请选择要删除的管理员" }
                  },
                  "fail": { "value": { "code": -1, "mes": "删除失败" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/admins/{id}": {
      "get": {
        "tags": ["管理员"],
        "summary": "根据 ID 查询管理员",
        "operationId": "getAdminById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "管理员 ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "管理员信息",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoAdmin" },
                "examples": {
                  "success": {
                    "value": {
                      "code": 0,
                      "mes": "ok",
                      "data": { "id": 1, "username": "admin", "adminType": 1 }
                    }
                  },
                  "not-found": {
                    "value": { "code": -1, "mes": "管理员不存在" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admins/{id}/password": {
      "put": {
        "tags": ["管理员"],
        "summary": "修改管理员密码",
        "description": "通过 body 传入新密码（`{\"password\": \"...\"}`），将指定管理员的密码更新为新值。",
        "operationId": "updateAdminPassword",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "管理员 ID",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["password"],
                "properties": {
                  "password": {
                    "type": "string",
                    "description": "新密码（不能为空）",
                    "minLength": 1
                  }
                }
              },
              "example": { "password": "newpassword" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "修改结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "examples": {
                  "success": { "value": { "code": 0, "mes": "ok" } },
                  "empty-password": {
                    "value": { "code": -1, "mes": "密码不能为空" }
                  },
                  "fail": { "value": { "code": -1, "mes": "修改失败" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/readers/{id}": {
      "get": {
        "tags": ["读者"],
        "summary": "根据 ID 查询读者",
        "description": "返回结果中 `password` 字段为 `null`（不序列化）。",
        "operationId": "getReaderById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "读者 ID",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "读者信息",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoReader" },
                "examples": {
                  "success": {
                    "value": {
                      "code": 0,
                      "mes": "ok",
                      "data": {
                        "id": 1,
                        "username": "zhangsan",
                        "realName": "张三",
                        "sex": "男",
                        "birthday": "2001-04-01",
                        "address": "江西南昌",
                        "tel": "13767134834",
                        "email": "zhangsan@163.com",
                        "registerDate": "2025-01-15T10:30:00.000+08:00",
                        "readerNumber": "8120116001"
                      }
                    }
                  },
                  "not-found": {
                    "value": { "code": -1, "mes": "读者不存在" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/readers/register": {
      "post": {
        "tags": ["读者"],
        "summary": "读者注册",
        "description": "注册成功后自动生成读者编号（前缀 `8120116` + 3 位流水号）。密码长度 6–20 位。",
        "operationId": "registerReader",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" },
              "example": {
                "username": "zhangsan",
                "password": "123456",
                "realName": "张三",
                "sex": "男",
                "birthday": "2001-04-01",
                "address": "江西南昌",
                "tel": "13767134834",
                "email": "zhangsan@163.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册结果",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "examples": {
                  "success": { "value": { "code": 0, "mes": "ok" } },
                  "duplicate": {
                    "value": { "code": -1, "mes": "用户名已经存在" }
                  },
                  "fail": {
                    "value": { "code": -1, "mes": "注册失败，请稍后重试" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/api/lends": {
      "get": {
        "tags": ["借阅"],
        "summary": "分页查询借阅记录",
        "description": "支持 `bookName` / `readerName` 模糊搜索、`backType` 筛选。返回 JOIN 后的 `bookName` / `bookAuthor` / `readerRealName` / `readerNumber`。",
        "operationId": "listLends",
        "parameters": [
          { "name": "pageNum", "in": "query", "required": false, "schema": { "type": "integer", "default": 1 }, "description": "页码（从 1 开始）" },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 10 }, "description": "每页条数" },
          { "name": "bookName", "in": "query", "required": false, "schema": { "type": "string" }, "description": "书名模糊搜索" },
          { "name": "readerName", "in": "query", "required": false, "schema": { "type": "string" }, "description": "读者姓名模糊搜索" },
          { "name": "backType", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "归还类型筛选" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataInfoLendList" } } }
          }
        }
      },
      "post": {
        "tags": ["借阅"],
        "summary": "借书",
        "description": "校验图书与读者存在、图书未被借出后插入借阅记录，并将图书状态置为已借出（status=1）。",
        "operationId": "lendBook",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LendRequest" } } }
        },
        "responses": {
          "200": {
            "description": "成功 / 业务失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "examples": {
                  "success": { "value": { "code": 0, "mes": "ok" } },
                  "book-loaned": { "value": { "code": -1, "mes": "该书已被借出，无法重复借阅" } },
                  "not-found": { "value": { "code": -1, "mes": "图书不存在" } }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["借阅"],
        "summary": "批量删除借阅记录",
        "description": "body 为借阅记录 ID 数组，如 `[1, 2, 3]`。",
        "operationId": "deleteLends",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "array", "items": { "type": "integer" } } } }
        },
        "responses": {
          "200": {
            "description": "成功 / 业务失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "examples": {
                  "success": { "value": { "code": 0, "mes": "ok" } },
                  "empty": { "value": { "code": -1, "mes": "请选择要删除的借阅记录" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/lends/{id}": {
      "get": {
        "tags": ["借阅"],
        "summary": "查询借阅详情",
        "operationId": "getLendById",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "借阅记录 ID" }
        ],
        "responses": {
          "200": {
            "description": "成功 / 业务失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoLend" },
                "examples": {
                  "success": { "value": { "code": 0, "mes": "ok", "data": { "id": 1, "bookId": 1, "readerId": 1, "lendDate": "2026-09-15T10:30:00", "bookName": "西游记", "readerRealName": "彭于晏" } } },
                  "not-found": { "value": { "code": -1, "mes": "借阅记录不存在" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/lends/{id}/back": {
      "put": {
        "tags": ["借阅"],
        "summary": "还书",
        "description": "设置归还日期、归还类型、备注，并将图书状态置为未借出（status=0）。已归还的记录不可重复操作。",
        "operationId": "backLend",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "借阅记录 ID" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LendBackRequest" } } }
        },
        "responses": {
          "200": {
            "description": "成功 / 业务失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "examples": {
                  "success": { "value": { "code": 0, "mes": "ok" } },
                  "already-backed": { "value": { "code": -1, "mes": "该记录已归还，请勿重复操作" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/lends/reader/{readerId}": {
      "get": {
        "tags": ["借阅"],
        "summary": "读者借阅历史",
        "operationId": "listLendsByReader",
        "parameters": [
          { "name": "readerId", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "读者 ID" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataInfoLendList" } } }
          }
        }
      }
    },
    "/api/lends/book/{bookId}": {
      "get": {
        "tags": ["借阅"],
        "summary": "图书借阅记录",
        "operationId": "listLendsByBook",
        "parameters": [
          { "name": "bookId", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "图书 ID" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataInfoLendList" } } }
          }
        }
      }
    },
    "/api/books": {
      "get": {
        "tags": ["图书"],
        "summary": "分页查询图书列表",
        "description": "支持 `name` 模糊搜索、`typeId` 分类筛选、`status` 状态筛选（0=未借出，1=已借出）。",
        "operationId": "listBooks",
        "parameters": [
          { "name": "pageNum", "in": "query", "required": false, "schema": { "type": "integer", "default": 1 }, "description": "页码（从 1 开始）" },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 10 }, "description": "每页条数" },
          { "name": "name", "in": "query", "required": false, "schema": { "type": "string" }, "description": "书名模糊搜索" },
          { "name": "typeId", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "分类 ID" },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "integer" }, "description": "状态（0=未借出，1=已借出）" }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DataInfoBookList" } } }
          }
        }
      },
      "post": {
        "tags": ["图书"],
        "summary": "新增图书",
        "description": "`status` 不传时默认 `0`（未借出）。",
        "operationId": "addBook",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookInfo" } } }
        },
        "responses": {
          "200": {
            "description": "成功 / 业务失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "examples": {
                  "success": { "value": { "code": 0, "mes": "ok" } },
                  "empty-name": { "value": { "code": -1, "mes": "图书名称不能为空" } },
                  "fail": { "value": { "code": -1, "mes": "新增失败" } }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["图书"],
        "summary": "批量删除图书",
        "description": "body 为图书 ID 数组，如 `[1, 2, 3]`。",
        "operationId": "deleteBooks",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "array", "items": { "type": "integer" } } } }
        },
        "responses": {
          "200": {
            "description": "成功 / 业务失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "examples": {
                  "success": { "value": { "code": 0, "mes": "ok" } },
                  "empty": { "value": { "code": -1, "mes": "请选择要删除的图书" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/books/{id}": {
      "get": {
        "tags": ["图书"],
        "summary": "根据 ID 查询图书",
        "operationId": "getBookById",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "图书 ID" }
        ],
        "responses": {
          "200": {
            "description": "成功 / 业务失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoBook" },
                "examples": {
                  "success": { "value": { "code": 0, "mes": "ok", "data": { "id": 1, "name": "西游记", "author": "施耐庵" } } },
                  "not-found": { "value": { "code": -1, "mes": "图书不存在" } }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["图书"],
        "summary": "修改图书信息",
        "operationId": "updateBook",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" }, "description": "图书 ID" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookInfo" } } }
        },
        "responses": {
          "200": {
            "description": "成功 / 业务失败",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DataInfoVoid" },
                "examples": {
                  "success": { "value": { "code": 0, "mes": "ok" } },
                  "not-found": { "value": { "code": -1, "mes": "图书不存在" } },
                  "fail": { "value": { "code": -1, "mes": "修改失败" } }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DataInfoVoid": {
        "type": "object",
        "description": "统一响应格式（无数据体）",
        "properties": {
          "code": {
            "type": "integer",
            "description": "状态码：0=成功，-1=失败",
            "enum": [0, -1]
          },
          "mes": {
            "type": "string",
            "description": "消息"
          }
        }
      },
      "DataInfoAdminList": {
        "type": "object",
        "description": "分页响应（管理员列表）",
        "properties": {
          "code": { "type": "integer", "enum": [0, -1] },
          "mes": { "type": "string" },
          "count": {
            "type": "integer",
            "format": "int64",
            "description": "总记录数"
          },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Admin" }
          }
        }
      },
      "DataInfoAdmin": {
        "type": "object",
        "description": "单条管理员响应",
        "properties": {
          "code": { "type": "integer", "enum": [0, -1] },
          "mes": { "type": "string" },
          "data": { "$ref": "#/components/schemas/Admin" }
        }
      },
      "DataInfoReader": {
        "type": "object",
        "description": "单条读者响应",
        "properties": {
          "code": { "type": "integer", "enum": [0, -1] },
          "mes": { "type": "string" },
          "data": { "$ref": "#/components/schemas/ReaderInfo" }
        }
      },
      "DataInfoMe": {
        "type": "object",
        "description": "当前用户响应",
        "properties": {
          "code": { "type": "integer", "enum": [0, -1] },
          "mes": { "type": "string" },
          "data": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "description": "角色：admin / reader",
                "enum": ["admin", "reader"]
              },
              "user": {
                "description": "用户对象（Admin 或 ReaderInfo，取决于 role）",
                "oneOf": [
                  { "$ref": "#/components/schemas/Admin" },
                  { "$ref": "#/components/schemas/ReaderInfo" },
                  { "type": "null" }
                ]
              }
            },
            "required": ["role"]
          }
        }
      },
      "Admin": {
        "type": "object",
        "description": "管理员实体（查询结果中 password 为 null）",
        "properties": {
          "id": {
            "type": "integer",
            "description": "管理员 ID"
          },
          "username": {
            "type": "string",
            "description": "用户名",
            "maxLength": 20
          },
          "password": {
            "type": ["string", "null"],
            "description": "密码（响应中为 null）"
          },
          "adminType": {
            "type": "integer",
            "description": "管理员类型：0=普通, 1=超级管理员"
          }
        }
      },
      "AdminCreate": {
        "type": "object",
        "description": "新增管理员请求体",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "description": "用户名",
            "maxLength": 20
          },
          "password": {
            "type": "string",
            "description": "密码",
            "maxLength": 20
          },
          "adminType": {
            "type": "integer",
            "description": "管理员类型：0=普通, 1=超级管理员（不传默认 1）"
          }
        }
      },
      "ReaderInfo": {
        "type": "object",
        "description": "读者实体",
        "properties": {
          "id": { "type": "integer", "description": "读者 ID" },
          "username": { "type": "string", "description": "用户名", "maxLength": 20 },
          "password": {
            "type": ["string", "null"],
            "description": "密码（响应中为 null）"
          },
          "realName": { "type": "string", "description": "真实姓名", "maxLength": 20 },
          "sex": { "type": "string", "description": "性别", "maxLength": 5 },
          "birthday": {
            "type": "string",
            "format": "date",
            "description": "出生日期"
          },
          "address": { "type": "string", "description": "籍贯", "maxLength": 30 },
          "tel": { "type": "string", "description": "电话", "maxLength": 11 },
          "email": { "type": "string", "description": "邮箱", "maxLength": 15 },
          "registerDate": {
            "type": "string",
            "format": "date-time",
            "description": "注册日期"
          },
          "readerNumber": {
            "type": "string",
            "description": "读者编号（前缀 8120116 + 3 位流水号）",
            "maxLength": 20
          }
        }
      },
      "LendList": {
        "type": "object",
        "description": "借阅记录（含 JOIN 展示字段）",
        "properties": {
          "id": { "type": "integer", "description": "借阅记录 ID" },
          "bookId": { "type": "integer", "description": "图书 ID" },
          "readerId": { "type": "integer", "description": "读者 ID" },
          "lendDate": { "type": "string", "format": "date-time", "description": "借出日期" },
          "backDate": { "type": ["string", "null"], "format": "date-time", "description": "归还日期（未归还时为 null）" },
          "backType": { "type": ["integer", "null"], "description": "归还类型" },
          "exceptRemarks": { "type": ["string", "null"], "description": "备注信息" },
          "bookName": { "type": ["string", "null"], "description": "书名（JOIN）" },
          "bookAuthor": { "type": ["string", "null"], "description": "作者（JOIN）" },
          "readerRealName": { "type": ["string", "null"], "description": "读者真实姓名（JOIN）" },
          "readerNumber": { "type": ["string", "null"], "description": "读者编号（JOIN）" }
        }
      },
      "LendRequest": {
        "type": "object",
        "description": "借书请求体",
        "required": ["bookId", "readerId"],
        "properties": {
          "bookId": { "type": "integer", "description": "图书 ID" },
          "readerId": { "type": "integer", "description": "读者 ID" }
        }
      },
      "LendBackRequest": {
        "type": "object",
        "description": "还书请求体",
        "properties": {
          "backType": { "type": "integer", "description": "归还类型" },
          "exceptRemarks": { "type": "string", "description": "备注信息" }
        }
      },
      "DataInfoLendList": {
        "type": "object",
        "description": "分页借阅记录列表响应",
        "properties": {
          "code": { "type": "integer", "enum": [0, -1] },
          "mes": { "type": "string" },
          "count": { "type": "integer", "format": "int64", "description": "总条数" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LendList" }
          }
        }
      },
      "DataInfoLend": {
        "type": "object",
        "description": "单条借阅记录响应",
        "properties": {
          "code": { "type": "integer", "enum": [0, -1] },
          "mes": { "type": "string" },
          "data": { "$ref": "#/components/schemas/LendList" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "登录请求体",
        "required": ["username", "password", "role"],
        "properties": {
          "username": {
            "type": "string",
            "description": "用户名",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "description": "密码",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "description": "角色",
            "enum": ["admin", "reader"]
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "description": "读者注册请求体",
        "required": ["username", "password", "realName"],
        "properties": {
          "username": {
            "type": "string",
            "description": "用户名",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "description": "密码",
            "minLength": 6,
            "maxLength": 20
          },
          "realName": {
            "type": "string",
            "description": "真实姓名",
            "minLength": 1
          },
          "sex": {
            "type": "string",
            "description": "性别"
          },
          "birthday": {
            "type": "string",
            "format": "date",
            "description": "出生日期"
          },
          "address": {
            "type": "string",
            "description": "籍贯"
          },
          "tel": {
            "type": "string",
            "description": "电话"
          },
          "email": {
            "type": "string",
            "description": "邮箱"
          }
        }
      },
      "BookInfo": {
        "type": "object",
        "description": "图书实体",
        "properties": {
          "id": { "type": "integer", "description": "图书 ID" },
          "name": { "type": "string", "description": "图书名称", "maxLength": 20 },
          "author": { "type": "string", "description": "作者", "maxLength": 30 },
          "publish": { "type": "string", "description": "出版社", "maxLength": 30 },
          "isbn": { "type": "string", "description": "书籍编号（ISBN）", "maxLength": 30 },
          "introduction": { "type": "string", "description": "简介", "maxLength": 50 },
          "language": { "type": "string", "description": "语言", "maxLength": 20 },
          "price": { "type": "number", "description": "价格" },
          "publishDate": { "type": "string", "format": "date", "description": "出版时间" },
          "typeId": { "type": "integer", "description": "分类 ID" },
          "status": { "type": "integer", "description": "状态：0=未借出，1=已借出（不传默认 0）" }
        }
      },
      "DataInfoBookList": {
        "type": "object",
        "description": "分页图书列表响应",
        "properties": {
          "code": { "type": "integer", "enum": [0, -1] },
          "mes": { "type": "string" },
          "count": { "type": "integer", "format": "int64", "description": "总条数" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/BookInfo" }
          }
        }
      },
      "DataInfoBook": {
        "type": "object",
        "description": "单条图书响应",
        "properties": {
          "code": { "type": "integer", "enum": [0, -1] },
          "mes": { "type": "string" },
          "data": { "$ref": "#/components/schemas/BookInfo" }
        }
      }
    }
  }
}
